```{r, parameters}
#| echo = FALSE
alpha0 <- c(
  0.5,
  -0.5
)
alpha1 <- c(
  0.25,
  -0.25
)
alpha_mu <- c(alpha0) + .5 * c(alpha1)
alpha_sigma <- matrix(
  data = c(
    0.10, -0.05,
    -0.05, 0.10
  ),
  nrow = 2,
  ncol = 2
)
alpha_sigma_l <- t(chol(alpha_sigma))
beta0 <- matrix(
  data = c(
    0.5, 0.0,
    0.0, 0.5
  ),
  nrow = 2,
  ncol = 2
)
beta1 <- matrix(
  data = c(
    0.25, 0.00,
    0.00, 0.25
  ),
  nrow = 2,
  ncol = 2
)
beta_mu <- c(beta0) + .5 * c(beta1)
beta_sigma <- matrix(
  data = c(
    0.020, 0.010, 0.000, 0.000,
    0.010, 0.015, 0.000, 0.000,
    0.000, 0.000, 0.010, 0.005,
    0.000, 0.000, 0.005, 0.015
  ),
  nrow = 4,
  ncol = 4
)
beta_sigma_l <- t(chol(beta_sigma))
psi <- list(
  matrix(
    data = c(
      0.20, -0.05,
      -0.05, 0.18
    ),
    nrow = 2,
    ncol = 2
  )
)
psi_l <- list(
  t(chol(psi[[1]]))
)
```

